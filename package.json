{
  "name": "sonara",
  "version": "3.6.1",
  "description": "Sonara: Spotify, SoundCloud and YouTube Music likes in one window",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakazueq/Sonara.git"
  },
  "homepage": "https://github.com/nakazueq/Sonara",
  "bugs": {
    "url": "https://github.com/nakazueq/Sonara/issues"
  },
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/",
    "release": "node tools/release.mjs",
    "icon": "node tools/make-icon.mjs",
    "build": "node tools/build.mjs"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "assets/icon-256.rgba",
      "assets/mkhelper.exe",
      "assets/splash.exe",
      "native/*.cs",
      "node_modules/@webviewjs/webview/*.js",
      "node_modules/@webviewjs/webview-win32-x64-msvc/*.node",
      "node_modules/@webviewjs/webview-win32-x64-msvc/package.json",
      "assets/icon-32.rgba"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/parser": "^7.29.12",
    "@yao-pkg/pkg": "^6.24.0",
    "pe-library": "^2.0.1",
    "resedit": "^2.0.3",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@webviewjs/webview": "^0.4.9"
  },
  "optionalDependencies": {
    "@webviewjs/webview-win32-x64-msvc": "^0.4.9"
  },
  "productName": "Sonara",
  "type": "commonjs"
}
